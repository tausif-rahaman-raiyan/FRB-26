# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BUNNY_CDN_HOSTNAME: Your Bunny CDN Pull Zone / Stream Hostname
# Example: vz-cb5996f0-784.b-cdn.net
BUNNY_CDN_HOSTNAME="vz-cb5996f0-784.b-cdn.net"

# BUNNY_TOKEN_SECURITY_KEY: The Token Authentication Security Key configured in Bunny dashboard
# Keep this secret on your server / Vercel environment variables. Never expose in frontend code!
BUNNY_TOKEN_SECURITY_KEY="your-bunny-token-security-key"

# FIREBASE_PROJECT_ID: Your Firebase Project ID for verifying user ID tokens
FIREBASE_PROJECT_ID="mystudytracker-693d3"

# ALLOWED_ORIGINS: Comma-separated list of domains permitted by CORS (e.g. Blogger domains)
ALLOWED_ORIGINS="https://tausifrahamanraiyan.blogspot.com,http://localhost:3000"

